# Lyra Pet environment. Copy to .env.local (and apps/pet/.env.local) for local work.
# The Supabase values below are the FIXED PUBLIC DEMO KEYS of the local stack (`supabase start`),
# identical on every machine. Never put cloud keys in this file.

# Supabase (local stack ports: API 55321, DB 55322, Studio 55323, Mailpit 55324)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU   # server only
APP_URL=http://localhost:3200
MAILPIT_URL=http://127.0.0.1:55324   # tests only

# Platform administration (comma-separated emails), later phases
PLATFORM_ADMIN_EMAILS=

# AI assistant (Phase 5) — server only
ANTHROPIC_API_KEY=
LYRA_MODEL_PRIMARY=claude-sonnet-5-5
LYRA_MODEL_FAST=claude-haiku-5-5

