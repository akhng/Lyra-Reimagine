{
  "name": "lyra-reimagine",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @lyra/pet dev",
    "build": "pnpm --filter @lyra/pet build",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit -p apps/pet && tsc --noEmit -p packages/platform && tsc --noEmit -p packages/ui",
    "test": "vitest run --project unit",
    "test:e2e": "pnpm --filter @lyra/pet test:e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/platform/src/database.ts",
    "db:test": "vitest run --project db",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.1",
    "supabase": "3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "16.4.5",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  }
}
